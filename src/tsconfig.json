{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "constants/*.ts",
    "errors/*.ts",
    "llm/*.ts",
    "policy/*.ts",
    "driver/*.ts",
    "persona/*.ts",
    "ui/*.ts",
    "tests/*.ts",
    "types/*.d.ts"
  ]
}
