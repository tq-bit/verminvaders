MISTRAL_API_KEY=<your-mistral-key>
# how many previous games (summaries + stats) the model sees in prompts
VERMINVADERS_CONTEXT_GAMES=5
# max game records kept in memory/mistral-strategy.json
VERMINVADERS_MEMORY_MAX_GAMES=10
# seed for the executor's randomness (exploration sampling + aim jitter);
# identical seeds replay identical executor choices — games still vary
# because the enemy fire is unseeded; 0 = the deterministic default
VERMINVADERS_RNG_SEED=0
# max completion tokens per strategy consultation
# (opening / wave plan / epoch update / post-mortem)
VERMINVADERS_MAX_TOKENS=1500
